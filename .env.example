# ─────────────────────────────────────────────────────────────────────────────
# Bling Records Talent Show — environment configuration template
#
# DO NOT put real secrets in this file. This file is committed to Git.
#
#   • Local dev:        copy this to `.env.local` (already in .gitignore) and
#                       fill in real values for development. Never commit it.
#   • Preview / prod:   set values in Vercel → Project → Settings → Environment
#                       Variables. Per-environment scoping is supported.
#
# If you ever paste a real secret into this file by mistake: rotate that
# secret with the provider before doing anything else. See README.md ▸
# Security and docs/agent-execution-rules.md ▸ Section 2.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required ───────────────────────────────────────────────────────────────

# JWT signing secret. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 24 chars (enforced in src/lib/auth.ts); recommended ≥ 48 random bytes.
JWT_SECRET=replace-with-output-of-the-node-command-above

# Postgres connection string (Neon). Use the POOLED connection — the host
# ends with `-pooler.<region>.aws.neon.tech`. Example shape:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# Public site URL (absolute links in emails, OG metadata, payment return URLs).
# In Codespaces this is auto-detected from CODESPACE_NAME.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Local seed credentials (used only by `npm run db:seed`) ────────────────
# These create the seeded admin / referee accounts in the dev database.
# Production deployments should NEVER seed — leave the seed step out of CI.
SEED_ADMIN_EMAIL=admin@blingshow.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
SEED_REFEREE_EMAIL=referee@blingshow.local
SEED_REFEREE_PASSWORD=replace-with-a-strong-local-password

# ─── Payments (AdmasPay / Telebirr) ─────────────────────────────────────────

# Hosted-checkout link. We record the payment locally as `pending` and redirect
# the user to this URL. AdmasPay webhooks still need TELEBIRR_HMAC_SECRET to
# be verified server-side. Get yours from the AdmasPay merchant dashboard;
# it looks like https://checkout.admaspay.com/apl_<uuid>.
ADMASPAY_CHECKOUT_URL=

# Full Telebirr / AdmasPay API integration. Leave blank to stay on the
# hosted-link flow above. If both are blank, the app falls back to stub mode
# (dev only) — see src/lib/payments.ts for the mode-resolution rules.
TELEBIRR_MERCHANT_ID=
TELEBIRR_APP_KEY=
TELEBIRR_HMAC_SECRET=
TELEBIRR_NOTIFY_URL=
TELEBIRR_API_URL=https://api.telebirr.com/v1

# ─── Cloudinary (audition video upload) ─────────────────────────────────────
# Required once Phase 3 ships. The browser uploads directly to Cloudinary
# using a signed intent generated server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=blingrecordsshow_signed

# ─── Optional LLM-backed chatbot ────────────────────────────────────────────
# When set, /api/chatbot calls Anthropic. Otherwise it uses the static
# bilingual keyword matcher in src/data/chatbot.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Rate-limiting (production) ─────────────────────────────────────────────
# Without these, the app uses an in-memory rate limiter (single-instance only,
# fine for dev / Codespaces but not safe for production on Vercel where each
# request may hit a different serverless instance). Set both to enable the
# Upstash-backed limiter — see src/lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
