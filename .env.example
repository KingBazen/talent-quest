# ─────────────────────────────────────────────────────────────────────────────
# TalentQuest — environment configuration
#
# Copy to .env.local for development. NEVER commit .env or .env.local.
# In production (Vercel/Render/etc.), set these in the platform's secrets UI.
# ─────────────────────────────────────────────────────────────────────────────

# Required — JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# Required — Postgres connection string. Get this from Neon's dashboard
# (use the POOLED connection — it ends with `-pooler.<region>.aws.neon.tech`).
# Example:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/talentquest?sslmode=require
DATABASE_URL=

# Public site URL (used for absolute links in emails, OG metadata, payment
# return URLs). In Codespaces this is auto-detected from CODESPACE_NAME.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default seeded admin / referee credentials (only used by `npm run db:seed`).
SEED_ADMIN_EMAIL=admin@talentquest.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_REFEREE_EMAIL=referee@talentquest.local
SEED_REFEREE_PASSWORD=Referee1234!

# ─── Payments ───────────────────────────────────────────────────────────────
# Quickest path: point at an AdmasPay hosted checkout link. We record the
# payment locally as pending and redirect the user to this URL. Webhooks
# from AdmasPay still need TELEBIRR_HMAC_SECRET to be verified.
ADMASPAY_CHECKOUT_URL=

# Full Telebirr / AdmasPay API integration. Leave blank to stay on the
# hosted-link flow above (or fall back to local stub if neither is set).
TELEBIRR_MERCHANT_ID=
TELEBIRR_APP_KEY=
TELEBIRR_HMAC_SECRET=
TELEBIRR_NOTIFY_URL=
TELEBIRR_API_URL=https://api.telebirr.com/v1

# ─── Cloudinary (video upload) ──────────────────────────────────────────────
# Leave blank to fall back to local /public/uploads (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=talentquest_signed

# ─── Optional LLM-backed chatbot ────────────────────────────────────────────
# When set, /api/chatbot uses Anthropic; otherwise falls back to the static
# bilingual keyword matcher in src/data/chatbot.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
