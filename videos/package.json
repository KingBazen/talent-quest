{
  "name": "talent-quest-videos",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion compositions for TalentQuest promo videos (TikTok / Reels / YouTube / Telegram).",
  "scripts": {
    "studio": "remotion studio",
    "render:reels": "remotion render PromoReels out/promo-reels.mp4",
    "render:square": "remotion render PromoSquare out/promo-square.mp4",
    "render:landscape": "remotion render PromoLandscape out/promo-landscape.mp4",
    "render:all": "npm run render:reels && npm run render:square && npm run render:landscape",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.457",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.457"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
